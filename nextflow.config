manifest {
    name            = 'Pipeline_ATACSeq_nf'
    author          = 'Jack Freeland'
    description     = 'Nextflow DSL2 conversion of the bulk ATAC-seq bash pipeline (jfreeland01/Pipeline_ATACSeq)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

params {
    // ---- Input (PREPROCESSING) ----
    input               = null   // samplesheet CSV: sample,fastq_1,fastq_2

    // ---- Standalone post-processing inputs (each stage is runnable on its own via -entry) ----
    peaks_dir           = null   // dir of *.narrowPeak files, searched recursively   (CONSENSUS_PEAKS)
    bams_dir            = null   // dir of filtered *_V8.bam files                    (CONSENSUS_PEAKS)
    homer_input_dir     = null   // dir of *.txt peak files for motif calling         (MOTIF_ENRICHMENT)
    wig_input_dir       = null   // dir of *.wig files to average                     (WIG_MEAN)
    bigwig_dir          = null   // dir of *.bw files                                 (TSS_HEATMAP)

    // ---- Reference files ----
    bowtie2_index       = null   // path PREFIX to a Bowtie2 index, e.g. /refs/GRCh38_noalt_decoy_as/GRCh38_noalt_decoy_as
    blacklist_bed       = null   // ENCODE blacklist BED
    chrom_sizes         = null   // chrom.sizes file for bigWig/wig conversion
    tss_bed             = null   // TSS reference-point BED for computeMatrix

    // ---- Trimming (cutadapt) ----
    adapter_r1          = 'CTGTCTCTTATA'   // Nextera; swap for your library prep kit
    adapter_r2           = 'CTGTCTCTTATA'
    trim_quality_cutoff    = 20
    trim_min_overlap         = 6
    trim_min_length            = 35

    // ---- Post-alignment filtering ----
    mapq_threshold                = 30
    exclude_contigs_pattern        = 'chrM|Un|random|decoy'

    // ---- Peak calling (MACS3) ----
    macs_genome_size                = 'hs'
    macs_qvalue                      = 0.01

    // ---- bigWig (deepTools bamCoverage) ----
    effective_genome_size             = 2913022398   // human (GRCh38); override for other organisms
    bigwig_binsize                     = 10

    // ---- HOMER motif enrichment ----
    homer_genome                        = 'hg38'

    // ---- TSS accessibility (computeMatrix / plotHeatmap) ----
    tss_before                           = 3000
    tss_after                             = 3000
    tss_binsize                            = 10

    // ---- General ----
    outdir                                  = 'results'
    threads                                  = 4
}

profiles {
    docker {
        docker.enabled      = true
        conda.enabled       = false
        docker.runOptions   = System.getProperty("os.arch") == "aarch64" ? "--platform linux/amd64" : ""
    }
    conda {
        conda.enabled   = true
        docker.enabled  = false
    }
    test {
        includeConfig 'conf/test.config'
    }
}

includeConfig 'conf/base.config'
