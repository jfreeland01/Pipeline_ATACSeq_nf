// Lightweight resource overrides for smoke-testing on a laptop with a small
// subsampled dataset. Sample sheet / reference paths still come from the CLI
// (--input, --bowtie2_index, --blacklist_bed, ...) — see README "Testing".

params {
    outdir  = 'results_test'
    threads = 2
}

process {
    withLabel: process_high {
        cpus   = 2
        memory = '4.GB'
    }
    withLabel: process_medium {
        cpus   = 2
        memory = '3.GB'
    }
}
