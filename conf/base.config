process {
    // Nextflow's default `bash -ue` only checks the last command's exit code
    // in a pipe; -o pipefail makes a failure anywhere in a pipe (e.g.
    // BOWTIE2_ALIGN's `bowtie2 | samtools view`) fail the whole task instead
    // of silently producing an empty/truncated output.
    shell  = ['/bin/bash', '-euo', 'pipefail']

    cpus   = { params.threads }
    memory = '4.GB'
    time   = '12.h'

    errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = 1
        memory = '8.GB'
    }
    withLabel: process_medium {
        cpus   = { Math.min(params.threads as int, 4) }
        memory = '24.GB'
    }
    withLabel: process_high {
        cpus   = { params.threads }
        memory = '48.GB'
    }
}
